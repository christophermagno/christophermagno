        <view>
          <datasources>
            <datasource caption='my_books_data_CLEAN+' name='federated.0t13vsl01nla3t18h27wf1y278ov' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Radial Inner' datatype='real' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='0.4'>
              <calculation class='tableau' formula='0.4' />
            </column>
            <column caption='Radial Outer' datatype='real' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='0.9'>
              <calculation class='tableau' formula='0.9' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0t13vsl01nla3t18h27wf1y278ov'>
