              <calculation class='tableau' formula='[Number of Pages]' />
            </column>
            <column caption='Path Order' datatype='integer' name='[Calculation_1310828982264197122]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IIF([Table Name] = &quot;my_books_data_CLEAN.csv&quot;, 0, 1)' />
            </column>
            <column caption='Radial Angle' datatype='real' name='[Calculation_1310828982264705029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(INDEX()-1) * (1/WINDOW_COUNT(COUNT([Calculation_1260867173894926363]))) * 2 * PI()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Radial Normalised  Length' datatype='real' name='[Calculation_1310828982264930310]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] + IIF(ATTR([Calculation_1310828982264197122]) = 0, 0, SUM([Calculation_1260867173894926363])/WINDOW_MAX(SUM([Calculation_1260867173894926363])) * ([Parameters].[Parameter 2]-[Parameters].[Parameter 1]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Radial X' datatype='real' name='[Calculation_1310828982265585671]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1310828982264930310] * COS([Calculation_1310828982264705029])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Radial Y' datatype='real' name='[Calculation_1310828982265667592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1310828982264930310] * SIN([Calculation_1310828982264705029])'>
