      </layout-options>
      <repository-location derived-from='https://public.tableau.com/workbooks/ChicagoTrafficAccidentAnalysis/Fatalities?rev=' id='124781711' path='/workbooks/ChicagoTrafficAccidentAnalysis' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='chicago_traffic_crashes_CLEAN' name='federated.1nycifj0740cz21bnjbpr1lvp2dd' />
          </datasources>
          <datasource-dependencies datasource='federated.1nycifj0740cz21bnjbpr1lvp2dd'>
            <column caption='Crash Date' datatype='datetime' name='[CRASH_DATE]' role='dimension' type='ordinal' />
            <column caption='Crash Type' datatype='string' name='[CRASH_TYPE]' role='dimension' type='nominal' />
            <column caption='cTotalFatalities' datatype='integer' name='[Calculation_707839211657728002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='TOTAL(SUM([INJURIES_FATAL]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
