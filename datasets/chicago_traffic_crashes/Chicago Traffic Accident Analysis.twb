                  </zone-style>
                </zone>
                <zone fixed-size='280' h='22939' id='3' is-fixed='true' name='Where did it happen?' show-caption='true' w='95062' x='2469' y='11947'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
