                <zone fixed-size='280' h='19753' id='638' is-fixed='true' name='Traffic/Intersection Control' w='59109' x='2470' y='34895'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
